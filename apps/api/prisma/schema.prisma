// =============================================================================
// AI Kids Creator Academy — Prisma Schema
// PostgreSQL (Supabase) — snake_case tables, PascalCase models
// Date: 2026-07-20
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Isolated path avoids Windows EPERM locks on hoisted root node_modules
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── A. CORE IDENTITY ─────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         String // student | parent | teacher | admin
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  pinHash      String?  @map("pin_hash")
  /**
   * Google OIDC subject (`sub`). Optional; same email always one row.
   * Login with Google links here without creating a second account.
   */
  googleSub    String?  @unique @map("google_sub")
  /**
   * Firebase Auth UID for StoryMee SSO/custom-token bridge.
   */
  firebaseUid  String?  @unique @map("firebase_uid")
  nickname     String?
  avatarId     String?  @map("avatar_id")
  level        Int      @default(1)
  xp           Int      @default(0)
  onboarded    Boolean  @default(false)
  goal         String?
  active       Boolean  @default(true)
  parentId     String?  @map("parent_id") @db.Uuid
  classId      String?  @map("class_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  // Self-references
  parent   User?  @relation("ParentChildren", fields: [parentId], references: [id])
  children User[] @relation("ParentChildren")

  // FK to classroom
  class ClassRoom? @relation("StudentClass", fields: [classId], references: [id])

  // Relations
  sessions                Session[]
  enrollments             Enrollment[]
  questProgress           QuestProgress[]
  assets                  Asset[]
  projects                Project[]
  approvalsMade           Approval[]           @relation("Approver")
  approvalsOwned          Approval[]           @relation("ChildApprovals")
  taughtClasses           ClassRoom[]          @relation("TeacherClasses")
  achievements            Achievement[]
  streak                  DailyStreak?
  notifications           Notification[]
  pushDevices             PushDevice[]
  storageObjects          StorageObject[]
  parentProfile           ParentProfile?
  teacherProfile          TeacherProfile?
  /**
   * Household subscriptions where this user is the billing parent
   */
  subscriptions           Subscription[]       @relation("ParentSubscriptions")
  loginLogs               LoginLog[]
  storybookStickers       StorybookSticker[]
  rewardInventory         RewardInventory[]
  rewardEquipment         RewardEquipment[]
  sentFriendInvites       FriendInvite[]       @relation("FriendInviteSender")
  receivedFriendInvites   FriendInvite[]       @relation("FriendInviteRecipient")
  connectionsAsA          ChildConnection[]    @relation("ConnectionChildA")
  connectionsAsB          ChildConnection[]    @relation("ConnectionChildB")
  favoriteConnections     FavoriteConnection[]
  blocksCreated           ChildBlock[]         @relation("BlockCreator")
  blocksReceived          ChildBlock[]         @relation("BlockTarget")
  socialActivities        SocialActivity[]
  socialReactions         SocialReaction[]
  publicProfile           PublicProfile?
  workspaceGrantsApproved WorkspaceGrant[]     @relation("WorkspaceGrantApprover")

  @@index([role, active])
  @@index([createdAt])
  @@map("users")
}

// ── A2. FAMILY / HOUSEHOLD BILLING (ClassDojo / Khan Kids pattern) ─
// Parent owns plan + child profiles. Children never hold payment methods.

model Plan {
  id                     String   @id
  code                   String   @unique
  name                   String
  tagline                String
  maxChildren            Int      @map("max_children")
  maxOpenCoursesPerChild Int      @map("max_open_courses_per_child")
  priceMonthly           Int      @default(0) @map("price_monthly")
  currency               String   @default("VND")
  featuresJson           String   @map("features_json")
  sortOrder              Int      @default(0) @map("sort_order")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentUserId       String    @map("parent_user_id") @db.Uuid
  planId             String    @map("plan_id")
  status             String    @default("active") // active | trialing | cancelled | expired
  seats              Int
  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  /**
   * manual | stripe | apple | google — v1 uses manual / seed
   */
  provider           String    @default("manual")
  externalId         String?   @map("external_id")
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  parent User @relation("ParentSubscriptions", fields: [parentUserId], references: [id], onDelete: Cascade)
  plan   Plan @relation(fields: [planId], references: [id])

  @@index([parentUserId, status])
  @@index([planId])
  @@map("subscriptions")
}

model ParentProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  phone             String?
  preferredLanguage String   @default("vi") @map("preferred_language")
  notificationPrefs Json     @default("{}") @map("notification_prefs")
  maxChildren       Int      @default(5) @map("max_children")
  ///
  /// Parent Gate PIN — bcrypt hash of the PIN the child enters when tapping
  /// "Ba/Mẹ ơi!" to hand device back to parent.
  ///
  /// ⚠️ DISTINCT FROM user.pinHash:
  ///   user.pinHash = child enters to LOGIN into their student account
  ///   gatePin      = child enters to UNLOCK the parent dashboard
  ///
  /// Nullable: when unset, gate redirects to parent login page instead.
  gatePin           String?  @map("gate_pin")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parent_profiles")
}

model TeacherProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  displayName        String?  @map("display_name")
  bio                String?
  subjects           String[] @default([])
  languages          String[] @default(["vi"])
  verificationStatus String   @default("none") @map("verification_status")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ClassRoom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  teacherId String   @map("teacher_id") @db.Uuid
  status    String   @default("active")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  teacher  User   @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  students User[] @relation("StudentClass")

  @@index([teacherId])
  @@map("classrooms")
}

// ── B. CURRICULUM & LEARNING ─────────────────────────────────

model Course {
  id              String   @id // stable slug e.g. l1-k1-the-gioi
  title           String
  shortTitle      String   @map("short_title")
  tagline         String
  description     String
  coverFrom       String   @map("cover_from")
  coverTo         String   @map("cover_to")
  accent          String
  coverImage      String?  @map("cover_image")
  ageLabel        String   @map("age_label")
  /// L1 (8–9) | L2 (10–11) — curriculum track
  ageTrack        String   @default("L1") @map("age_track")
  /// K1…K6 within a track
  courseKey       String   @default("K1") @map("course_key")
  durationLabel   String   @map("duration_label")
  productLabel    String   @map("product_label")
  status          String   @default("open")
  recommended     Boolean  @default(false)
  skillsJson      String   @map("skills_json")
  outcomesJson    String   @default("[]") @map("outcomes_json")
  recognitionJson String   @default("{}") @map("recognition_json")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  quests      Quest[]
  enrollments Enrollment[]

  @@index([status, sortOrder])
  @@index([ageTrack, courseKey])
  @@map("courses")
}

model Quest {
  id             String  @id // stable slug e.g. meet-mascot
  courseId       String  @map("course_id")
  order          Int
  title          String
  skill          String
  reward         String
  duration       String
  hook           String
  accent         String
  icon           String  @default("star")
  practiceKind   String  @default("chips") @map("practice_kind")
  /// ideate (no AI) | produce (with AI) — curriculum stages
  stage          String  @default("ideate")
  videoUrl       String? @map("video_url")
  goalsJson      String  @map("goals_json")
  learnCardsJson String  @map("learn_cards_json")
  checkJson      String  @map("check_json")
  chipsJson      String? @map("chips_json")
  /// Curriculum stations: video → game → practice → check
  stationsJson   String? @map("stations_json")
  /// Soft-archive for CMS (hidden from student catalog when true)
  archived       Boolean @default(false)

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress QuestProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("quests")
}

model Enrollment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model QuestProgress {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  questId   String   @map("quest_id")
  status    String   @default("locked")
  phase     String   @default("learn")
  stars     Int      @default(0)
  xpEarned  Int      @default(0) @map("xp_earned")
  dataJson  String?  @map("data_json")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([status, updatedAt])
  @@map("quest_progress")
}

// ── C. PORTFOLIO & SOCIAL ────────────────────────────────────

model Asset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  name      String
  questId   String?  @map("quest_id")
  thumbnail String
  private   Boolean  @default(true)
  metaJson  String?  @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@map("assets")
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  kind        String
  thumbnail   String
  private     Boolean  @default(true)
  shareStatus String   @default("private") @map("share_status")
  dataJson    String?  @map("data_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvals       Approval[]
  workspaceGrants WorkspaceGrant[]

  @@index([userId, updatedAt, id])
  @@map("projects")
}

model Approval {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  destination String   @default("family")
  status      String   @default("pending")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  child   User    @relation("ChildApprovals", fields: [childId], references: [id], onDelete: Cascade)
  parent  User?   @relation("Approver", fields: [parentId], references: [id])

  @@index([parentId, status])
  @@index([childId])
  @@map("approvals")
}

// ── D. GAMIFICATION ──────────────────────────────────────────

model Achievement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("achievements")
}

model DailyStreak {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  current        Int      @default(0)
  longest        Int      @default(0)
  lastActiveDate String   @map("last_active_date")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_streaks")
}

/// Idempotent record of a sticker earned from a trusted domain event.
model StorybookSticker {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  stickerId     String   @map("sticker_id")
  sourceEventId String   @unique @map("source_event_id")
  sourceType    String   @map("source_type")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([userId, earnedAt])
  @@map("storybook_stickers")
}

/// Server-side ownership record. Catalog presentation remains in @aikids/domain.
model RewardInventory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  rewardId      String   @map("reward_id")
  sourceEventId String   @unique @map("source_event_id")
  sourceType    String   @map("source_type")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
  @@index([userId, unlockedAt])
  @@map("reward_inventory")
}

/// At most one equipped reward per kind for each child.
model RewardEquipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String
  rewardId  String   @map("reward_id")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
  @@map("reward_equipment")
}

/// Short-lived invitation. Only a keyed hash of the displayed code is stored.
model FriendInvite {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderChildId             String    @map("sender_child_id") @db.Uuid
  recipientChildId          String?   @map("recipient_child_id") @db.Uuid
  codeHash                  String    @unique @map("code_hash")
  status                    String    @default("created")
  recipientAcceptedAt       DateTime? @map("recipient_accepted_at")
  senderParentApprovedAt    DateTime? @map("sender_parent_approved_at")
  recipientParentApprovedAt DateTime? @map("recipient_parent_approved_at")
  expiresAt                 DateTime  @map("expires_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at")

  senderChild    User  @relation("FriendInviteSender", fields: [senderChildId], references: [id], onDelete: Cascade)
  recipientChild User? @relation("FriendInviteRecipient", fields: [recipientChildId], references: [id], onDelete: Cascade)

  @@index([senderChildId, status])
  @@index([recipientChildId, status])
  @@index([expiresAt])
  @@map("friend_invites")
}

/// Canonically ordered child pair; active rows are the social graph.
model ChildConnection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childAId   String   @map("child_a_id") @db.Uuid
  childBId   String   @map("child_b_id") @db.Uuid
  status     String   @default("active")
  approvedAt DateTime @default(now()) @map("approved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  childA    User                 @relation("ConnectionChildA", fields: [childAId], references: [id], onDelete: Cascade)
  childB    User                 @relation("ConnectionChildB", fields: [childBId], references: [id], onDelete: Cascade)
  favorites FavoriteConnection[]

  @@unique([childAId, childBId])
  @@index([childAId, status])
  @@index([childBId, status])
  @@map("child_connections")
}

model FavoriteConnection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId      String   @map("child_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  child      User            @relation(fields: [childId], references: [id], onDelete: Cascade)
  connection ChildConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([childId, connectionId])
  @@unique([childId, position])
  @@index([connectionId])
  @@map("favorite_connections")
}

/// Directional block. A block revokes the connection for both children.
model ChildBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerChildId String   @map("blocker_child_id") @db.Uuid
  blockedChildId String   @map("blocked_child_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  blockerChild User @relation("BlockCreator", fields: [blockerChildId], references: [id], onDelete: Cascade)
  blockedChild User @relation("BlockTarget", fields: [blockedChildId], references: [id], onDelete: Cascade)

  @@unique([blockerChildId, blockedChildId])
  @@index([blockedChildId])
  @@map("child_blocks")
}

/// Server-generated milestone card. No free-text child-authored status exists.
model SocialActivity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorChildId  String   @map("actor_child_id") @db.Uuid
  type          String
  title         String
  summary       String
  icon          String?
  coverUrl      String?  @map("cover_url")
  rewardId      String?  @map("reward_id")
  referenceId   String?  @map("reference_id")
  audiences     String[]
  sourceEventId String   @unique @map("source_event_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor     User             @relation(fields: [actorChildId], references: [id], onDelete: Cascade)
  reactions SocialReaction[]

  @@index([actorChildId, createdAt])
  @@index([createdAt])
  @@map("social_activities")
}

/// One selected reaction per child/activity; changing reaction updates this row.
model SocialReaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  actorChildId String   @map("actor_child_id") @db.Uuid
  type         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  activity   SocialActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actorChild User           @relation(fields: [actorChildId], references: [id], onDelete: Cascade)

  @@unique([activityId, actorChildId])
  @@index([actorChildId, type, createdAt])
  @@index([activityId, type])
  @@map("social_reactions")
}

/// Child-controlled profile settings. Public reads always use a safe projection.
model PublicProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId    String   @unique @map("child_id") @db.Uuid
  slug       String   @unique
  enabled    Boolean  @default(false)
  visibility String[]
  modules    String[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("public_profiles")
}

/// Audience grant for one creative project. Pending grants never authorize reads.
model WorkspaceGrant {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  audience     String
  permission   String    @default("view")
  status       String    @default("pending")
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("WorkspaceGrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([projectId, audience])
  @@index([status, audience])
  @@index([approvedById])
  @@map("workspace_grants")
}

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  title             String
  body              String
  read              Boolean   @default(false)
  data              String?
  /// not_requested | queued | processing | sent | failed
  pushStatus        String    @default("not_requested") @map("push_status")
  pushAttempts      Int       @default(0) @map("push_attempts")
  pushNextAttemptAt DateTime? @map("push_next_attempt_at")
  pushLastError     String?   @map("push_last_error")
  pushDispatchedAt  DateTime? @map("push_dispatched_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([pushStatus, pushNextAttemptAt])
  @@map("notifications")
}

/// Browser/device installation that can receive Firebase Cloud Messaging.
/// Tokens are server-only and never returned by list-notification APIs.
model PushDevice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String
  tokenHash String   @unique @map("token_hash")
  platform  String   @default("web")
  enabled   Boolean  @default(true)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("push_devices")
}

/// Ownership record for direct-to-Firebase-Storage uploads.
/// The object path is generated by the API; clients cannot choose another owner.
model StorageObject {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  objectPath String    @unique @map("object_path")
  bucket     String
  purpose    String
  fileName   String    @map("file_name")
  mime       String
  size       Int?
  status     String    @default("pending")
  questId    String?   @map("quest_id")
  projectId  String?   @map("project_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  readyAt    DateTime? @map("ready_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("storage_objects")
}

// ── E. SYSTEM SETTINGS (secrets encrypted at rest) ───────────

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  /// AES-GCM ciphertext (base64) — never return raw to clients
  valueEnc  String?  @map("value_enc")
  /// Non-secret metadata JSON (e.g. last4, configuredAt)
  metaJson  String   @default("{}") @map("meta_json")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// ── F. LOGIN AUDIT LOG (auto-purged after 24 h) ───────────────
// Stored in DB, never contains password hashes or tokens.
// OWASP A07: tracks failed logins for anomaly detection.

model LoginLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null when login failed (unknown user)
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  /// success | failed | locked
  outcome   String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  /// reason when outcome = failed/locked
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Index on createdAt for efficient 24-h purge query
  @@index([createdAt])
  @@index([userId])
  @@index([outcome])
  @@map("login_logs")
}
